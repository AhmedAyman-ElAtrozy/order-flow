# OrderFlow local environment.
# Copy to .env (git-ignored):   Copy-Item .env.example .env
# These are DEV-ONLY defaults. Never reuse them anywhere real.
#
# Postgres runs db/init.sql only on an empty volume. After changing any DB
# password here, run:  .\scripts\dev.ps1 reset   (deletes all local data)

# --- PostgreSQL admin (superuser, used only by init and verify scripts) ---
POSTGRES_ADMIN_USER=orderflow_admin
POSTGRES_ADMIN_PASSWORD=dev-admin-change-me

# --- Per-service DB users (one schema each, see db/init.sql) ---
# identity_svc  -> schema identity   (api-identity)
# orders_svc    -> schema orders     (order-orchestrator)
# inventory_svc -> schema inventory  (inventory)
# payments_svc  -> schema payments   (payment-adapter)
IDENTITY_DB_PASSWORD=dev-identity-change-me
ORDERS_DB_PASSWORD=dev-orders-change-me
INVENTORY_DB_PASSWORD=dev-inventory-change-me
PAYMENTS_DB_PASSWORD=dev-payments-change-me

# --- Kafka (KRaft) ---
# 22-char base64url cluster id, generated with:
#   docker run --rm apache/kafka:3.9.1 /opt/kafka/bin/kafka-storage.sh random-uuid
# Changing it on an existing kafka-data volume makes the broker refuse to start.
KAFKA_CLUSTER_ID=0pG0d-1oTAOwKDhEj0XVlA

# --- Redis (rate limit + 2s status cache only; never authoritative) ---
REDIS_PASSWORD=dev-redis-change-me

# --- Dev override host ports (docker-compose.dev.yml, bound to 127.0.0.1) ---
# 5433, not 5432: avoids clashing with a native PostgreSQL install on the host.
# Kafka stays 9092 because its advertised EXTERNAL listener is localhost:9092.
POSTGRES_HOST_PORT=5433

# --- Connection hints (not read by compose) ---
# Inside the compose network:   postgres:5432   kafka:19092       redis:6379
# From the host (dev override): 127.0.0.1:5433  localhost:9092    127.0.0.1:6379
